{
  "name": "canvas-mcp-server",
  "version": "3.0.0",
  "description": "Model Context Protocol server for Canvas LMS — lets AI assistants read course content, extract text from files, search across courses, and manage the full Canvas API",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "canvas-mcp-server": "build/index.js"
  },
  "mcp": {
    "server": {
      "command": "node",
      "args": [
        "./build/index.js"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "npm run build && npm run start",
    "clean": "rimraf build",
    "type-check": "tsc --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DMontgomery40/mcp-canvas-lms.git"
  },
  "keywords": [
    "canvas",
    "lms",
    "mcp",
    "model-context-protocol",
    "education",
    "ai",
    "claude",
    "pdf",
    "text-extraction"
  ],
  "author": "David Montgomery <dmontg@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DMontgomery40/mcp-canvas-lms/issues"
  },
  "homepage": "https://github.com/DMontgomery40/mcp-canvas-lms#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "officeparser": "^5.1.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
