# Required
CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_DOMAIN=your_domain.instructure.com

# Role-based tool filtering (default: all)
# student = ~44 student-safe tools, all = everything including admin tools
CANVAS_ROLE=all

# Transport: stdio (default, for Claude Desktop) or streamable-http
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=streamable-http)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

# Optional tuning
LOG_LEVEL=info
CANVAS_MAX_RETRIES=3
CANVAS_RETRY_DELAY=1000
CANVAS_TIMEOUT=30000
